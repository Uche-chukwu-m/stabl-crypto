# Copy to .env.local for local development. On Vercel, set these in Project
# Settings, Environment Variables. Nothing secret uses the NEXT_PUBLIC_ prefix.

# Neon Postgres (added automatically by the Vercel Marketplace integration).
DATABASE_URL=

# Plaid. Leave both empty to run in local mode (test bank data straight into the database).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox for the demo; production only with Trial plan keys.
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-domain/api/plaid/webhook

# openssl rand -base64 32
TOKEN_ENC_KEY=
# npx auth secret
AUTH_SECRET=

# Resend. Without a key, sign in links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Stabl <hello@your-domain>

# npx web-push generate-vapid-keys. Subject is a mailto address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain
# Same public key, for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# BotFather in Telegram. The secret is any random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_NAME=

# Random strings.
CRON_SECRET=
ADMIN_KEY=

VAULT_APY=3.50
STABL_SHARE_RATE=2.00

# true allows sign in with just an email address (until Resend is set up) and
# turns on the presenter page at /admin, which also needs ADMIN_KEY.
DEMO_MODE=true

# Public URL of this deployment, used in links and the Telegram webhook.
# Vercel fills in its production URL if this is empty.
APP_URL=

# ---- The vault on Arc. Leave these empty to use the simulated ledger. ----

# Circle developer console (test key) and the entity secret registered with it.
# Keep the entity secret's recovery file somewhere safe and out of git.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Printed by `npm run chain:setup`.
CIRCLE_WALLET_SET_ID=
STABL_OPERATOR_WALLET_ID=
STABL_OPERATOR_ADDRESS=
# Printed by `npm run chain:deploy`.
ARC_VAULT_ADDRESS=
# Optional. Defaults to https://rpc.testnet.arc.io
ARC_RPC_URL=
# USDC's smallest units per cent. 10000 is one dollar to one USDC. The test
# network build uses 10, because the faucet gives 20 USDC at a time.
ARC_UNITS_PER_CENT=10

# QuickNode. The API key manages the stream (scripts only). The token signs every
# delivery to /api/chain/stream: any random string of 32 characters or more,
# for example `openssl rand -hex 32`.
QUICKNODE_API_KEY=
QUICKNODE_STREAM_TOKEN=

# Set to mock to force the simulated ledger even when the keys above are present.
VAULT_PROVIDER=

# Copy to .env.local for local development. On Vercel, set these in Project
# Settings, Environment Variables. Nothing secret uses the NEXT_PUBLIC_ prefix.

# Neon Postgres (added automatically by the Vercel Marketplace integration).
DATABASE_URL=

# Plaid. Leave both empty to run in local mode (demo data straight into the database).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox for the demo; production only with Trial plan keys.
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-domain/api/plaid/webhook

# openssl rand -base64 32
TOKEN_ENC_KEY=
# npx auth secret
AUTH_SECRET=

# Resend. Without a key, sign in links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Stabl <hello@your-domain>

# npx web-push generate-vapid-keys. Subject is a mailto address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain
# Same public key, for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# BotFather in Telegram. The secret is any random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_NAME=

# Random strings.
CRON_SECRET=
ADMIN_KEY=

VAULT_APY=3.50
STABL_SHARE_RATE=2.00

# true shows the demo tools: /admin, /try, demo banks, judge controls.
DEMO_MODE=true

# Public URL of this deployment, used in links and the Telegram webhook.
# Vercel fills in its production URL if this is empty.
APP_URL=
